# Use email mode with a verified sender and recipient.
# For a deliberate development-only dry run, set ENQUIRY_MODE=local.
# If omitted, complete Resend settings automatically enable email mode.
ENQUIRY_MODE=email
# SITE_ORIGIN=https://vedagroup.uk
# RESEND_API_KEY=
# Sender must be on a domain verified in Resend.
# ENQUIRY_FROM=Veda Group <no-reply@vedagroup.uk>
# Admin inbox(es) that receive enquiries; comma-separate several.
# ENQUIRY_TO=
# Production requires a shared Redis-compatible REST rate limiter.
# Development email tests use the local limiter when Redis is not configured.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# SEO: canonical public origin (separate from enquiry request validation).
SITE_URL=https://vedagroup.uk
# Production on SITE_URL is indexable by default; no setting is needed.
# Development, Vercel previews and other origins automatically block indexing.
# Set SEO_INDEXING=false only for a staging build served on the official origin.
# SEO_INDEXING=false
# Enable only after hosting serves non-www directly; otherwise a redirect loop results.
# SEO_CANONICAL_REDIRECT=true
# Optional Google Search Console HTML verification token (not a secret).
# GOOGLE_SITE_VERIFICATION=
