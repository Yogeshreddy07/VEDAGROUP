# Local testing discards enquiries; never sends email.
ENQUIRY_MODE=local
# Enable email only after recipient, sender, privacy copy and deployment review.
# ENQUIRY_MODE=email
# SITE_ORIGIN=https://vedagroup.uk
# RESEND_API_KEY=
# Sender must be on a domain verified in Resend.
# ENQUIRY_FROM=Veda Group <no-reply@vedagroup.uk>
# Admin inbox(es) that receive enquiries; comma-separate several.
# ENQUIRY_TO=
# Production requires a shared Redis-compatible REST rate limiter.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
